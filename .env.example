# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=polish_vocab

# OpenAI API Key (for AI features)
PVS_OPENAI_API_KEY=sk-...

# JWT Secret (generate a random string)
JWT_SECRET=your-secret-key-here

# Admin Username
ADMIN_USERNAME=admin

# Server Port
PORT=3000

# SMTP Email Configuration (for sending verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Polish Vocab Studio <your-email@gmail.com>"

# Optional: Unsplash API (for image search in describe exercise)
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
